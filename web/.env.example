# OpenQuant web — environment variables
# Copy to `.env.local` and fill in. Every value below is a seam into an
# external paid/self-hosted service; the skeleton runs with placeholders.

# --- Clerk (authentication) -------------------------------------------------
# SEAM: sign-in / sign-up / session management.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<your-pk_test_value>
CLERK_SECRET_KEY=<your-sk_test_value>
# Optional Clerk redirect overrides.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/post-sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/post-sign-in

# --- Stripe (billing / entitlements) ---------------------------------------
# SEAM: subscription checkout, customer portal, and paid-tier gating.
STRIPE_SECRET_KEY=<your-sk_test_value>
STRIPE_PRICE_ID=<your-price_value>
STRIPE_WEBHOOK_SECRET=<your-whsec_value>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<your-pk_test_value>

# --- PostHog (product analytics) -------------------------------------------
# SEAM: client + server analytics capture.
NEXT_PUBLIC_POSTHOG_KEY=<your-phc_value>
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Data API / engine service ---------------------------------------------
# SEAM: the market-data + backtest engine (owned by /home/user/openquant/engine).
DATA_API_URL=http://localhost:8001
DATA_API_TOKEN=change-me

# --- AI research agent service ---------------------------------------------
# SEAM: the Python "Quant Copilot" agent service.
AGENT_SERVICE_URL=http://localhost:8002
AGENT_SERVICE_TOKEN=change-me

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
